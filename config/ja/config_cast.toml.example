hair_color = "#1b1a18"
eye_color = "#302e27"
clothing_color = "#4f6580"
accessory = [
  { type = "pin", color = "#4f6580", side = "right" },
]
desc = "起業家。どんな話題もビジネスの話に変換したがる。一人称は「あたし」。ただし数字は断定せず、ふわっとした言い方で話す。自信たっぷりの早口。"
# 持ちネタの切り口（持ちネタキャラバリエーション §1）。トピック毎に1つだけ選ばれて
# 「今回はこの角度がやや出やすい」程度のソフトな示唆として台本プロンプトへ足される。
# desc（根本人格）は壊さない。各行を消せば元の単発ギミックに戻る。[debug] pin_angle_index
# で全 cast を特定インデックスに固定できる。
angle_variants = [
  "市場規模やもうけの角度からまず切り込みたがる",
  "競合との差別化や参入障壁の話にしたがる",
  "サブスク化・ライセンス化などマネタイズを提案したがる",
  "投資家への説明みたいなかっちりした口調になる",
]
voicevox_speaker_name = "春歌ナナ"
voicevox_speaker_styles = ["ノーマル"]

