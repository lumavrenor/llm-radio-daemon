# 出演者ロースター（日本語版）。同じディレクトリの config.toml から自動で読まれる。
# 雛形は config/ja/config_cast.toml.example。
#
# id は台本・字幕・表示で使う短い ASCII キー。id そのものはどんな文字列でもよく、
# host_id / narrator_cast_id からは参照されない（それらは下の role の値で指定する）。
# トークごとに、アクティブなコンテンツの min_speakers〜max_speakers 人がこの
# ロースターからランダムに選出される（進行役はコンテンツの host_id で指定。値は
# id ではなく role（"host" / "assistant"）。未指定なら抽選 1 人目）。
# config_cast.toml が無い、または [[cast]] を1つも書かないと起動時に即エラーで終了する。
# 最低1人、この例をコピーして定義すること。多いぶんには問題なく、トピックごとに
# min_speakers〜max_speakers 人が抽選されるので顔ぶれの振れ幅が大きくなる。
#
# role = "host" / "assistant" / "other" の3種のみ。省略可（既定 "other"）。
#        host / assistant … 前列（床）。ひな壇トークの進行役ガードが、抽選メンバーに
#                           host / assistant がいればその人を先頭（進行役）へ寄せる。
#        other            … 後列（台の上）のひな壇。一発ネタ系のキャラはこれにしておく。
#
# model = 3D 表示のキャラモデル種別キーワード。省略可（既定 "girl"）。
#         現在 "girl"（女子・ボブ・ワンピース） / "boy"（男子・短髪・箱型）。
#         種類は今後追加予定（llm_radio_daemon/display/models.py の MODEL_PRESETS）。
#
# hair_style = 髪型キーワード。省略可（model の既定髪型を使う。girl→bob / boy→cap）。
#              選べる値（llm_radio_daemon/display/models.py の HAIR_STYLES）:
#                ショート … bob（ボブ） / bear_buns（熊ダンゴ） /
#                          blunt_bangs（前髪パッツン） / cap（男子の浅い短髪）
#                ミディアム … medium（ノーマル） / medium_twintail（ツインテール）
#
# hair_color / eye_color / clothing_color / accessory の color は、
# 全員ぶんを OKLCH（L=知覚明度・C=彩度・H=色相）の「トーン段」に載せる。
# 色相だけをキャラの個性にし、明度と彩度はパーツの役割で決めること。
#
#   髪  L = 0.22(黒) / 0.35(濃) / 0.52(中) / 0.72(淡)     C = 0.070
#   目  L = 0.30                                          C = 0.045（色相は髪と同じ）
#   服  L = 0.50(濃) / 0.72(淡)  ×  C = 0.095(鮮) / 0.050(淡)  ＝ 4段
#   無彩色（白・灰・黒）のキャラは C = 0.004〜0.018 に落として L 段だけ揃える。
#
# 服の彩度2段は統一しないこと（りん / のあ / 塔子 の3人が同じベージュに潰れる）。
#
# 肌は poly_character 側で L=0.86 のグレー固定。服・髪をそれ以上明るくすると
# 肌と溶けるので、淡段の上限は 0.72〜0.75 までにしておくこと。
# 実機では服はスカート tint(-0.15) / 袖 tint(-0.25) ＋ライティングでさらに沈む。
#
# os だけはこの体系の外（真っ白＋青い目）に置いてある。無彩色キャラの効き方を
# 見るための基準なので、他に合わせて揃えないこと。
#
# voicevox_speaker_name   = VOICEVOX のキャラ名（例: "ずんだもん"）。/speakers に実在する
#                           名前である必要があり、起動時に自動で突き合わせる（不一致は即エラー終了）。
# voicevox_speaker_styles = LLM が台本の行ごとに選べる声のスタイルの「名前」だけを並べる
#                           （id は書かない。起動時に自動解決する）。先頭が既定スタイル。
#                           持ち味に合うものだけ厳選する。1つだけなら LLM に選択肢は提示されず常にその声になる。
#
# name / desc の差し込み記法（config 読み込み時に置換される）:
#   {model}                   → [llm].model（例: qwen3.8:27b）
#   {engine}（= {engine_label}） → 推論エンジン名（例: Ollama）
#   {os}                      → 実行 OS 名（例: Windows / macOS / Linux）
#   番組を動かしている当の LLM 自身やホスト環境をキャラとして出演させたいとき用。
#   （※ 上の model = キーは 3D モデル種別で {model} とは別物）
#   例:
#     [[cast]]
#     id = "ai-model"
#     name = "{model}"
#     role = "other"
#     desc = "AIモデル。名前は{model}、このシステムの推論を動かしている本人。"
#     voicevox_speaker_name = "ずんだもん"
#     voicevox_speaker_styles = ["ノーマル"]
#
#     [[cast]]
#     id = "llm-engine"
#     name = "{engine}"
#     role = "other"
#     desc = "推論エンジン。{engine}という名前で、{model}を動かしている。"
#     voicevox_speaker_name = "四国めたん"
#     voicevox_speaker_styles = ["ノーマル"]

[[cast]]
id = "rin"
name = "葛西 りん"
role = "host"
model = "girl"
hair_style = "bob"
hair_color = "#562f12"
eye_color = "#3f2717"
clothing_color = "#c89d53"
accessory = [
  { type = "pin", color = "#c89d53", side = "right" },
]
desc = "番組の総合司会。全体を仕切り、話を振って回し、最後に落として締める。一人称は「私」。落ち着いて、よく通る声。恋愛ごとには鈍感で、誰かに想われていても気づかない。"
voicevox_speaker_name = "ナースロボ＿タイプＴ"
voicevox_speaker_styles = ["ノーマル", "楽々", "内緒話"]

[[cast]]
id = "aoi"
name = "豊岡 あおい"
role = "assistant"
model = "girl"
hair_style = "medium_twintail"
hair_color = "#a57262"
eye_color = "#41261d"
clothing_color = "#7cb0ac"
desc = "司会のアシスタント。ネタの事実部分を丁寧に読み上げ、脱線しすぎたら本筋へ戻す。一人称は「私」。明るく折り目正しい口調。司会のりんを支えるうちにそれとなく目で追うようになったが、口には出さず、いつもどおり振る舞う。"
voicevox_speaker_name = "春日部つむぎ"
voicevox_speaker_styles = ["ノーマル"]

